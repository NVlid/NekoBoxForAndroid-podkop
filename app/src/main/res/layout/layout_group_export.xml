<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp">

    <EditText
        android:id="@+id/export_name_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/partial_export_search_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1" />

    <CheckBox
        android:id="@+id/export_only_available"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/partial_export_only_available" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/export_select_visible"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/partial_export_select_visible" />

        <Button
            android:id="@+id/export_clear_visible"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/partial_export_clear_visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/export_selected_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textAlignment="center" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="360dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/export_profiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/export_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/partial_export_empty"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
